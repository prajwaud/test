# Copy to .env and fill in. Never commit .env.
# The first three come from the Entra admin - see ADMIN-ENTRA-REQUEST.md.

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# The mailbox to read and send from.
BRIEF_MAILBOX=praj@waudcapital.com

# For the Claude API call that synthesizes the brief.
ANTHROPIC_API_KEY=

# --- Timezone ---
# UNRESOLVED: the mailbox is configured Central and WCP is Chicago-based, but Eastern was
# specified. Confirm with Prithvi before trusting the times. See docs/TEST-LOG.md.
# Graph is asked to return times already in this zone, so this is the only place to change.
BRIEF_DISPLAY_TIMEZONE=America/New_York
BRIEF_TIMEZONE_LABEL=ET

# Local hour the brief should send at, in BRIEF_DISPLAY_TIMEZONE.
BRIEF_TARGET_HOUR=5

# Sonnet is the right tier for daily triage. Opus is not warranted here.
BRIEF_MODEL=claude-sonnet-5
